{
      "extends": "../../tsconfig.base.json",
      "compilerOptions": {
            "rootDir": "src",
            "outDir": "dist",
            "module": "commonjs",
            "moduleResolution": "node",
            "target": "ES2022",
            "noEmit": false,
            "declaration": false,
            "declarationMap": false,
            "sourceMap": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "removeComments": true,
            "incremental": true,
            "strict": true,
            "skipLibCheck": true,
            "noUncheckedIndexedAccess": true
      },
      "include": [
            "src/**/*.ts"
      ],
      "exclude": [
            "node_modules",
            "dist",
            "test",
            "**/*.spec.ts",
            "**/*.test.ts"
      ]
}